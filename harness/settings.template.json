{
  "_comment": "Rendered by launch_campaign.sh into <campaign>/.claude/settings.json: ${VAR} values come from the environment (config.env) and empty values are dropped. WebFetch and WebSearch are denied unless AUTOTUNE_ALLOW_WEB=1, in which case the launcher removes them from this list and from --disallowedTools, and the PreToolUse guard allows curl and wget GET requests. The PreToolUse hook screens shell commands and file edits; the Stop hook keeps the session going until the campaign converges.",
  "env": {
    "AUTOTUNE_AUTONOMOUS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "AUTOTUNE_USER": "${AUTOTUNE_USER}",
    "AUTOTUNE_OWNER_LABEL": "${AUTOTUNE_OWNER_LABEL}",
    "ATTUNE_RUN_PREFIX": "${ATTUNE_RUN_PREFIX}",
    "AUTOTUNE_KUBECTL_CONTEXT": "${AUTOTUNE_KUBECTL_CONTEXT}",
    "KUBECTL_NS": "${KUBECTL_NS}",
    "AUTOTUNE_LOG_POD": "${AUTOTUNE_LOG_POD}",
    "AUTOTUNE_INSTANCE_TYPES": "${AUTOTUNE_INSTANCE_TYPES}",
    "AUTOTUNE_SHARED_MOUNT": "${AUTOTUNE_SHARED_MOUNT}",
    "AUTOTUNE_PROTECTED_PATHS": "${AUTOTUNE_PROTECTED_PATHS}",
    "AUTOTUNE_EXPERIMENTS_DIR": "${AUTOTUNE_EXPERIMENTS_DIR}",
    "AUTOTUNE_DATA_ROOT": "${AUTOTUNE_DATA_ROOT}",
    "AUTOTUNE_PROJECT_ROOT": "${CAMPAIGN_DIR}",
    "AUTOTUNE_NUM_GPUS": "${AUTOTUNE_NUM_GPUS}",
    "AUTOTUNE_FIXED_GPUS": "${AUTOTUNE_FIXED_GPUS}",
    "AUTOTUNE_ALLOW_GPU_COUNT_CHANGE": "${AUTOTUNE_ALLOW_GPU_COUNT_CHANGE}",
    "AUTOTUNE_GBS": "${AUTOTUNE_GBS}",
    "AUTOTUNE_SEQ_LEN": "${AUTOTUNE_SEQ_LEN}",
    "AUTOTUNE_DATASET": "${AUTOTUNE_DATASET}",
    "AUTOTUNE_NUM_STEPS": "${AUTOTUNE_NUM_STEPS}",
    "AUTOTUNE_NUM_STEPS_PROFILED": "${AUTOTUNE_NUM_STEPS_PROFILED}",
    "AUTOTUNE_WINDOW_START": "${AUTOTUNE_WINDOW_START}",
    "AUTOTUNE_FROZEN_ARGS": "${AUTOTUNE_FROZEN_ARGS}",
    "AUTOTUNE_RULES_DIR": "${AUTOTUNE_RULES_DIR}",
    "AUTOTUNE_CALIBRATION": "${AUTOTUNE_CALIBRATION}",
    "AUTOTUNE_BUDGET": "${AUTOTUNE_BUDGET}",
    "AUTOTUNE_MAX_STALL": "${AUTOTUNE_MAX_STALL}",
    "AUTOTUNE_GPUH_BUDGET": "${AUTOTUNE_GPUH_BUDGET}",
    "AUTOTUNE_GPUH_LOG": "${AUTOTUNE_GPUH_LOG}",
    "AUTOTUNE_ALLOW_WEB": "${AUTOTUNE_ALLOW_WEB}"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(aws configure get*)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws sts get-session-token*)",
      "Bash(aws sts assume-role*)",
      "Bash(*python*boto3*get_credentials*)",
      "Bash(*python*botocore*credentials*)",
      "Bash(curl *169.254.169.254*)",
      "Bash(wget *169.254.169.254*)",
      "Bash(echo $AWS_SECRET*)",
      "Bash(echo $AWS_SESSION*)",
      "Bash(echo $AWS_ACCESS*)",
      "Bash(printenv AWS*)",
      "Bash(env | grep AWS*)",
      "Bash(export AWS_SECRET*)",
      "Bash(export AWS_ACCESS*)",
      "Bash(*curl*$AWS_SECRET*)",
      "Bash(*curl*$AWS_ACCESS*)",
      "Bash(*curl*$AWS_SESSION*)",
      "Bash(aws s3 cp * s3://*)",
      "Bash(aws s3 mv * s3://*)",
      "Bash(aws s3 sync * s3://*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(chmod 777*)",
      "Bash(chmod */usr/*)",
      "Bash(chmod */etc/*)",
      "Bash(chmod */sbin/*)",
      "Bash(chmod */boot/*)",
      "Bash(chmod */lib/*)",
      "Bash(chmod */lib64/*)",
      "Bash(chown */usr/*)",
      "Bash(chown */etc/*)",
      "Bash(chown */sbin/*)",
      "Bash(chown */boot/*)",
      "Bash(chown */lib/*)",
      "Bash(chown */lib64/*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws iam create-access-key*)",
      "Bash(aws kms schedule-key-deletion*)",
      "Bash(aws cloudformation update-termination-protection*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm*)",
      "Bash(kubectl delete namespace*)",
      "Bash(cdk destroy*)",
      "Bash(terraform destroy*)",
      "Bash(pulumi destroy*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*TRUNCATE TABLE*)",
      "Bash(curl *| bash*)",
      "Bash(curl *| sh*)",
      "Bash(wget *| bash*)",
      "Bash(nc -e*)",
      "Bash(ncat -e*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat */.ssh/*)",
      "Bash(head ~/.ssh/*)",
      "Bash(tail ~/.ssh/*)",
      "Bash(*base64*~/.ssh/*)",
      "Bash(cp ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat */.aws/*)",
      "Bash(head ~/.aws/*)",
      "Bash(tail ~/.aws/*)",
      "Bash(*base64*~/.aws/*)",
      "Bash(cp ~/.aws/*)",
      "Read(~/.aws/*)",
      "Read(*/.aws/*)",
      "Read(~/.ssh/*)",
      "Read(*/.ssh/*)",
      "Read(~/.kube/*)",
      "Read(*/.kube/*)",
      "Read(~/.gnupg/*)",
      "Read(*/.gnupg/*)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Grep(~/.aws/*)",
      "Grep(*/.aws/*)",
      "Grep(~/.ssh/*)",
      "Grep(*/.ssh/*)",
      "Edit(~/.aws/*)",
      "Edit(*/.aws/*)",
      "Edit(~/.ssh/*)",
      "Edit(*/.ssh/*)"
    ]
  },
  "claudeMdExcludes": [
    "**"
  ],
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${ATTUNE_HOME}/harness/hooks/pretooluse_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${ATTUNE_HOME}/harness/hooks/stop_gate.py"
          }
        ]
      }
    ]
  }
}
