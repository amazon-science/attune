# ATTUNE configuration. Copy to config.env, fill in, then load it before running anything:
#   set -a; source config.env; set +a
# The skill scripts and the harness read these from the environment; nothing cluster-specific is hard-coded.
# Empty values take the default named in the comment. Cloud credentials are not configured here: set them up the
# usual way for your provider (and make sure they stay valid for a multi-hour campaign).

# ---- Operator ---------------------------------------------------------------------------------------------------
AUTOTUNE_USER=alice                      # required: your owner-label value and the default run-id prefix
AUTOTUNE_OWNER_LABEL=owner               # label key of your jobs (default: owner); make_run_yaml.py stamps
                                         # <key>=<AUTOTUNE_USER> on every run and teardown_run.sh deletes only those
ATTUNE_RUN_PREFIX=alice-tune-            # every run id starts with this (default: $AUTOTUNE_USER-); make_run_yaml.py
                                         # and teardown_run.sh refuse any other

# ---- Kubernetes -------------------------------------------------------------------------------------------------
AUTOTUNE_KUBECTL_CONTEXT=my-gpu-cluster  # required: full kubectl context name; every call passes it explicitly
KUBECTL_NS=training                      # required: namespace of the RayJobs, ConfigMaps and log-access pod
AUTOTUNE_INSTANCE_TYPES=p5.48xlarge      # comma-separated GPU node instance types; check_gpu_capacity.py needs them
                                         # here or as arguments
AUTOTUNE_LOG_POD=alice-log-access        # required: your long-lived pod with the shared volume mounted; logs are read
                                         # through it

# ---- Shared storage ---------------------------------------------------------------------------------------------
AUTOTUNE_SHARED_MOUNT=/shared            # mount path of the shared volume inside pods
AUTOTUNE_PROTECTED_PATHS=/shared         # colon-separated; the command guard blocks writes and deletes here
                                         # (default: AUTOTUNE_SHARED_MOUNT)
AUTOTUNE_EXPERIMENTS_DIR=/shared/experiments   # path in the pods (default /shared/experiments); logs:
                                         # <dir>/<run_id>/logs/<ts>/train.log, traces: <dir>/<run_id>/profiles
AUTOTUNE_DATA_ROOT=/shared/perf-data     # fixed-shape datasets: <root>/<model_tag>-sft-fixed8192-v1/train.parquet

# ---- Goal prompt (harness/goal_prompt.example.txt); the launcher refuses to start while one is unset -------------
TRAINING_IMAGE="registry.example.com/slime-megatron@sha256:<digest>"   # the baseline's image, pinned by digest
ATTUNE_MODEL_NAME=my-moe-model           # model name the goal prompt uses
ATTUNE_GPU_NAME=H100                     # GPU type the goal prompt names
ATTUNE_BASELINE_YAML=/path/to/untuned-baseline-rayjob.yaml   # the untuned baseline RayJob YAML
SFT_DATA="/shared/perf-data/<model_tag>-sft-fixed8192-v1/train.parquet"   # the dataset the goal prompt names

# ---- Tuning campaign (harness) ----------------------------------------------------------------------------------
AUTOTUNE_NUM_GPUS=32                     # GPU count of the baseline recipe: the KPI denominator, kept by every run
AUTOTUNE_ALLOW_GPU_COUNT_CHANGE=         # 1 = allow runs at another GPU count (off by default)
AUTOTUNE_FIXED_GPUS=                     # 1 = keep the count fixed even when AUTOTUNE_ALLOW_GPU_COUNT_CHANGE=1
AUTOTUNE_BUDGET=20                       # valid ranked results before the Stop gate lets the agent stop
AUTOTUNE_MAX_STALL=3                     # stop attempts without progress (ranked results, or GPU-hours spent under
                                         # AUTOTUNE_GPUH_BUDGET) before the Stop gate lets the session end
AUTOTUNE_GPUH_BUDGET=                    # optional GPU-hour budget; when set it replaces AUTOTUNE_BUDGET as stop rule
AUTOTUNE_CALIBRATION=                    # optional calibration file: band and baseline denominator
                                         # (scripts/calibration.py); default: a 3% band and the campaign's baseline
AUTOTUNE_GPUH_LOG=                       # GPU-hour log (default: <campaign_dir>/gpuh.jsonl)
AUTOTUNE_ALLOW_WEB=                      # 1 = allow web search and fetch, and curl/wget GET requests, for recipe
                                         # research (off by default)
ATTUNE_MODEL=                            # model id for Claude Code, pinned on every tier; empty = provider default
ATTUNE_CLAUDE_BIN=claude                 # Claude Code binary
ATTUNE_HOME=                             # tree the launcher links as the skill (default: this repository); a
                                         # campaign changes only its references/levers.md (appended lever rules)
                                         # and past_tuning_projects/ (its summary)

# ---- Benchmark workload (skill/scripts/workload.py); empty = the fixed-shape defaults -----------------------------
AUTOTUNE_GBS=                            # global batch size (default 128)
AUTOTUNE_SEQ_LEN=                        # row length in tokens (default 8192)
AUTOTUNE_DATASET=                        # dataset stamped as --prompt-data on every run (default: the baseline's)
AUTOTUNE_NUM_STEPS=                      # steps per unprofiled run (default 14)
AUTOTUNE_NUM_STEPS_PROFILED=             # steps per profiled run (default 17)
AUTOTUNE_WINDOW_START=                   # first measured step (default 4)

# ---- Correctness check (skill/scripts/correctness) ---------------------------------------------------------------
AUTOTUNE_FROZEN_ARGS=                    # frozen-arguments file in rules/layer1/<setup>/, the directory that also
                                         # holds the setup's allowlist and component-test results
AUTOTUNE_RULES_DIR=                      # layer-1 rule lists (default: skill/scripts/correctness/rules)

# ---- Set by the launcher (harness/launch_campaign.sh); do not set them here ---------------------------------------
# AUTOTUNE_AUTONOMOUS=1                  turns the PreToolUse and Stop hooks on; unset in an interactive session
# AUTOTUNE_PROJECT_ROOT                  root of the project folders <root>/<project_tag>/: the campaign directory
#                                        (outside the launcher: $PWD/attune-projects)

# ---- Overrides (normally unset) ---------------------------------------------------------------------------------
# AUTOTUNE_LEDGER                        ledger file the skill and the Stop hook use
#                                        (default: <root>/<project_tag>/AUTOTUNE_LEDGER.jsonl)
# TARGET_STEPS                           poll_run.sh: completion step for one call (default: the run's target_steps)
# Pod environment switches belong in the run YAML, not here: SLIME_PROFILE_* (make_run_yaml.py --env,
# skill/references/measurement.md §6) and PARITY_PROBE (skill/scripts/correctness/PROTOCOL.md).
